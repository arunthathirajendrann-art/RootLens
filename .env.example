# Incident Response AI - Environment Configuration

# Set LLM_MOCK_MODE to true for deterministic mock responses (no API key required)
LLM_MOCK_MODE=true

# LLM Provider: "gemini" or "openai"
LLM_PROVIDER=gemini

# Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Model Selection
LLM_MODEL=gemini-2.5-flash
